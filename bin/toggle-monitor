#!/bin/bash

# Toggle which display is enabled: the desk monitor or the TV.
#
# The Hyprland override is written as a Lua file into the toggles directory that
# ~/.config/hypr/hyprland.lua sources after hypr/monitors, so it survives
# reloads and reboots. Same mechanism as omarchy-hyprland-monitor-internal.
#
# The TV is powered and switched to this machine's input through LG Buddy.
#
# An LG OLED holds its DisplayPort link up while in standby, so the DRM
# connector reads "connected" even when the panel is off. Whether the TV is
# usable is therefore decided by its reported power state, not by DRM. DRM
# connectivity only tells us whether the cable is attached at all.

set -uo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/console-mode/config.env"

# Hardware specifics live in a config file so these scripts can be deployed to
# a machine with different outputs, audio devices, and TV.
if [[ -r $CONFIG ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG"
fi

DESK_OUTPUT="${DESK_OUTPUT:-}"
TV_OUTPUT="${TV_OUTPUT:-}"
DESK_SINK="${DESK_SINK:-}"
TV_SINK="${TV_SINK:-}"
DESK_LABEL="${DESK_LABEL:-Desk monitor}"
TV_LABEL="${TV_LABEL:-TV}"

# webOS SSAP port. Answered whenever the TV is on the network at all, which is
# why it is only used as a cheap negative check.
TV_PORT="${TV_PORT:-3001}"

# How long to wait for the TV to wake after asking it to.
TV_WAIT_SECONDS="${TV_WAIT_SECONDS:-30}"

# How long to wait for a display to negotiate a mode and appear in Hyprland.
MONITOR_WAIT_SECONDS="${MONITOR_WAIT_SECONDS:-12}"

FLAG_FILE="${FLAG_FILE:-$HOME/.local/state/omarchy/toggles/hypr/monitor-toggle.lua}"

if [[ -z $DESK_OUTPUT || -z $TV_OUTPUT ]]; then
  echo "toggle-monitor: set DESK_OUTPUT and TV_OUTPUT in $CONFIG" >&2
  echo "toggle-monitor: available outputs: $(hyprctl monitors all -j 2>/dev/null |
    jq -r '[.[].name] | join(", ")')" >&2
  exit 1
fi

notify() {
  omarchy-notification-send -g 󰍹 "$1" 2>/dev/null || echo "$1"
}

have_lg_buddy() {
  command -v lg-buddy >/dev/null 2>&1
}

tv_ip() {
  have_lg_buddy && lg-buddy settings get tv.ip 2>/dev/null
}

# Cheap negative: a TV that is fully asleep drops off the network entirely.
# Used to avoid paying the power-state query's timeout in the common case.
tv_reachable() {
  local ip
  ip=$(tv_ip) || return 1
  [[ -n $ip ]] || return 1
  timeout 2 bash -c "echo > /dev/tcp/$ip/$TV_PORT" 2>/dev/null
}

# Reachability is not power. The TV keeps answering on its webOS port for
# several seconds after being told to turn off, and answers indefinitely once
# Quick Start+ is enabled, so a port probe reports a dark panel as ready.
# "Active" is the only state where the panel is actually showing our input;
# the transitional states report as Active with a processing field, which is
# why the match is exact.
tv_awake() {
  tv_reachable || return 1
  [[ $(tv-power-state 2>/dev/null) == Active ]]
}

drm_connected() {
  local status
  for status in /sys/class/drm/card*-"$1"/status; do
    [[ -r $status ]] && [[ $(<"$status") == connected ]] && return 0
  done
  return 1
}

monitor_enabled() {
  hyprctl monitors -j | jq -e --arg name "$1" 'any(.[]; .name == $name)' >/dev/null 2>&1
}

# A TV that has just woken needs several seconds to negotiate a mode and show
# up in Hyprland. Deciding after half a second declared a working switch failed
# and rolled it straight back.
wait_for_monitor() {
  local name="$1" waited=0 limit=$((MONITOR_WAIT_SECONDS * 2))
  while ((waited < limit)); do
    monitor_enabled "$name" && return 0
    sleep 0.5
    ((waited++))
  done
  return 1
}

# Guards against a cable that is not plugged in at all. It cannot detect a TV
# that is merely off, which is why the post-boot hook reasserts desk mode.
write_flag() {
  local disable="$1" require="$2"

  mkdir -p "$(dirname "$FLAG_FILE")"
  cat >"$FLAG_FILE" <<LUA
-- Generated by toggle-monitor. Delete this file to enable every display.
local disable = "$disable"
local require_connected = "$require"

local function connected(output)
  for card = 0, 9 do
    local path = string.format("/sys/class/drm/card%d-%s/status", card, output)
    local file = io.open(path, "r")
    if file then
      local status = file:read("*l")
      file:close()
      if status == "connected" then return true end
    end
  end
  return false
end

if connected(require_connected) then
  hl.monitor({ output = disable, disabled = true })
end
LUA
}

sink_present() {
  pactl list sinks short | cut -f2 | grep -qxF "$1"
}

# The GPU exposes one HDMI/DP audio profile at a time, so the TV's sink only
# appears once it is awake and driving a mode.
set_audio() {
  local sink="$1" id attempt

  # Audio switching is optional: an unconfigured sink simply leaves it alone.
  [[ -n $sink ]] || return 0

  for attempt in $(seq 12); do
    sink_present "$sink" && break
    sleep 0.5
  done

  if ! sink_present "$sink"; then
    notify "Audio output not available, left unchanged"
    return 0
  fi

  pactl set-default-sink "$sink" >/dev/null 2>&1 || return 0

  while read -r id _; do
    [[ -n $id ]] && pactl move-sink-input "$id" "$sink" >/dev/null 2>&1
  done < <(pactl list sink-inputs short)
}

# LG Buddy's sleep_wake_policy both powers the TV off before sleep *and*
# restores it after every wake. The restore fights keyboard-wake → desk mode,
# and the power-off path skips when LG Buddy has no ownership marker (which is
# how Big Picture suspend left the TV on). Console-mode's session monitor owns
# both sides instead, so this only ever leaves the policy disabled.
tv_sleep_policy() {
  have_lg_buddy || return 0
  lg-buddy settings set system.sleep_wake_policy disabled >/dev/null 2>&1
}

# Gamepad input does not reliably register as desktop activity, so the couch is
# where the screensaver would cut in mid-game. Desk mode gets normal idling back,
# which matters on an OLED panel.
idle_policy() {
  command -v omarchy >/dev/null 2>&1 || return 0
  omarchy toggle idle "$1" >/dev/null 2>&1
}

wake_tv() {
  have_lg_buddy || return 1

  tv_awake && return 0

  lg-buddy power on >/dev/null 2>&1

  local waited=0
  while ((waited < TV_WAIT_SECONDS)); do
    tv_awake && drm_connected "$TV_OUTPUT" && return 0
    sleep 1
    ((waited++))
  done
  return 1
}

current_mode() {
  [[ -f $FLAG_FILE ]] || return 1
  grep -q "^local disable = \"$DESK_OUTPUT\"\$" "$FLAG_FILE" && echo tv && return 0
  grep -q "^local disable = \"$TV_OUTPUT\"\$" "$FLAG_FILE" && echo desk && return 0
  return 1
}

# Applies the override and rolls it back if the display it was meant to hand
# over to never arrived.
apply_override() {
  local disable="$1" require="$2" label="$3" backup

  backup=$(mktemp)
  [[ -f $FLAG_FILE ]] && cp "$FLAG_FILE" "$backup"

  write_flag "$disable" "$require"
  hyprctl reload >/dev/null

  if ! wait_for_monitor "$require"; then
    if [[ -s $backup ]]; then
      cp "$backup" "$FLAG_FILE"
    else
      rm -f "$FLAG_FILE"
    fi
    hyprctl reload >/dev/null
    rm -f "$backup"
    notify "Could not enable $label, restored previous displays"
    return 1
  fi

  rm -f "$backup"
  return 0
}

tv() {
  if ! drm_connected "$TV_OUTPUT"; then
    notify "$TV_LABEL cable is not connected"
    exit 1
  fi

  if ! wake_tv; then
    notify "$TV_LABEL did not wake, staying on the $DESK_LABEL"
    exit 1
  fi

  apply_override "$DESK_OUTPUT" "$TV_OUTPUT" "$TV_LABEL" || exit 1

  set_audio "$TV_SINK"
  tv_sleep_policy # keep LG Buddy's auto restore disabled; we own sleep/wake
  idle_policy stay-awake
  notify "$TV_LABEL only"
}

desk() {
  if ! drm_connected "$DESK_OUTPUT"; then
    notify "$DESK_LABEL is not connected"
    exit 1
  fi

  apply_override "$TV_OUTPUT" "$DESK_OUTPUT" "$DESK_LABEL" || exit 1

  set_audio "$DESK_SINK"
  idle_policy allow-idle

  # Ordered last: Hyprland is already off the TV, so powering it down here
  # cannot strand the session on a display that is going dark.
  tv_sleep_policy
  if tv_awake; then
    # Prefer a direct SSAP turnOff: LG Buddy's power-off refuses without an
    # ownership marker, which is not always present after console-mode use.
    if command -v tv-power >/dev/null 2>&1; then
      tv-power off >/dev/null 2>&1 || notify "Could not power off the $TV_LABEL"
    elif have_lg_buddy; then
      lg-buddy power off >/dev/null 2>&1 || notify "Could not power off the $TV_LABEL"
    fi
  fi

  notify "$DESK_LABEL only"
}

# Login-time safe state, run from the Omarchy post-boot hook. Reasserts the desk
# monitor without touching TV power or audio, so a session can never start owned
# by a display that is switched off. It also keeps Hyprland from placing a
# workspace on the TV's standby link while the panel is dark.
boot() {
  drm_connected "$DESK_OUTPUT" || return 0
  tv_awake && return 0

  write_flag "$TV_OUTPUT" "$DESK_OUTPUT"
  hyprctl reload >/dev/null
  tv_sleep_policy
}

reset() {
  rm -f "$FLAG_FILE"
  hyprctl reload >/dev/null
  notify "All displays enabled"
}

toggle() {
  if [[ $(current_mode) == tv ]]; then
    desk
  else
    tv
  fi
}

status() {
  local mode
  mode=$(current_mode) || mode="none, all displays enabled"
  echo "mode:       $mode"
  echo "enabled:    $(hyprctl monitors -j | jq -r '[.[].name] | join(", ")')"
  echo "$DESK_OUTPUT cable:  $(drm_connected "$DESK_OUTPUT" && echo connected || echo disconnected)"
  echo "$TV_OUTPUT cable:  $(drm_connected "$TV_OUTPUT" && echo connected || echo disconnected)"
  echo "tv awake:   $(tv_awake && echo yes || echo no)"
  echo "audio:      $(pactl get-default-sink)"
  if have_lg_buddy; then
    echo "tv ip:      $(tv_ip)"
    echo "tv input:   $(lg-buddy settings get tv.input)"
    echo "tv sleep:   $(lg-buddy settings get system.sleep_wake_policy)"
  fi
}

case "${1:-toggle}" in
  toggle) toggle ;;
  desk) desk ;;
  tv) tv ;;
  boot) boot ;;
  reset | both) reset ;;
  status) status ;;
  # Just the mode, with no TV probe, for callers polling in a loop.
  mode) current_mode || echo none ;;
  *)
    echo "Usage: $(basename "$0") {toggle|desk|tv|boot|reset|status|mode}" >&2
    exit 1
    ;;
esac
