#!/bin/bash

# Console-mode wake monitor.
#
# After resume, the Steam Controller puck's wakeup counter says whether the
# controller woke us. If it did, enter console mode. If anything else woke us
# (keyboard, mouse, power button) while we were on the TV, switch back to the
# desk monitor.
#
# TV power-off before sleep is *not* handled here. A user-session
# PrepareForSleep handler races NetworkManager and loses — the Wi-Fi interface
# is already deactivating by the time SSAP runs. The NetworkManager
# pre-down.d hook (installed system-wide) blocks teardown until the TV is off.
#
# This polls rather than watching logind's resume signal: dbus-monitor's
# eavesdrop fallback delivered PrepareForSleep true but never the matching
# false. The poll loop freezes with the machine and cannot miss a resume.

set -uo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/console-mode/config.env"
if [[ -r $CONFIG ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG"
fi

VENDOR="${CONTROLLER_VENDOR:-28de}"
INTERVAL="${POLL_INTERVAL:-2}"
COOLDOWN="${COOLDOWN:-30}"
# A gap this far above INTERVAL can only mean the loop was frozen in suspend.
RESUME_GAP="${RESUME_GAP:-8}"

log() {
  printf '%s\n' "$*"
}

now_epoch() {
  printf '%(%s)T' -1
}

puck_dir() {
  local dir
  for dir in /sys/bus/usb/devices/*/; do
    [[ $(cat "$dir/idVendor" 2>/dev/null) == "$VENDOR" ]] || continue
    [[ -r "$dir/power/wakeup_active_count" ]] || continue
    printf '%s\n' "$dir"
    return 0
  done
  return 1
}

puck_count() {
  local dir
  dir=$(puck_dir) || return 1
  cat "$dir/power/wakeup_active_count" 2>/dev/null
}

last=$(puck_count) || last=0
last_action=0
previous=$(now_epoch)
log "watching wakes (puck start=$last, resume gap=${RESUME_GAP}s)"

while :; do
  sleep "$INTERVAL"

  moment=$(now_epoch)
  gap=$((moment - previous))
  previous=$moment

  count=$(puck_count) || continue
  [[ -n $count ]] || continue

  if ((count < last)); then
    last=$count
    continue
  fi

  # Awake path: only track the counter. Actions wait for a real resume so a
  # spurious increment cannot yank the session onto the TV mid-afternoon.
  if ((gap < RESUME_GAP)); then
    if ((count > last)); then
      log "puck signalled while awake ($last -> $count), ignoring"
      last=$count
    fi
    continue
  fi

  # Resumed. Give USB wakeup accounting a moment before deciding who woke us —
  # the puck counter can lag the poll thaw by a beat and would otherwise look
  # like a keyboard wake.
  sleep 1
  count=$(puck_count) || count=$last
  moment=$(now_epoch)

  puck_woke=0
  if ((count > last)); then
    log "puck signalled ($last -> $count)"
    last=$count
    puck_woke=1
  fi

  if ((moment - last_action < COOLDOWN)); then
    log "within cooldown after ${gap}s resume, skipping"
    continue
  fi

  mode=$(toggle-monitor mode 2>/dev/null || echo none)

  if ((puck_woke)); then
    if [[ $mode == tv ]]; then
      log "controller wake after ${gap}s, already in console mode"
      continue
    fi
    last_action=$moment
    log "controller wake after ${gap}s, entering console mode"
    console-mode
    continue
  fi

  # Non-controller wake: keyboard, mouse, power button, lid, etc.
  if [[ $mode == tv ]]; then
    last_action=$moment
    log "non-controller wake after ${gap}s, returning to desk"
    toggle-monitor desk
  else
    log "non-controller wake after ${gap}s, already on desk"
  fi
done
