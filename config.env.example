# Console mode hardware configuration.
#
# Installed to ~/.config/console-mode/config.env. Sourced by toggle-monitor.
# Find output names with:   hyprctl monitors all -j | jq -r '.[].name'
# Find sink names with:     pactl list sinks short | cut -f2

# Required: the two Hyprland outputs to toggle between.
DESK_OUTPUT=DP-2
TV_OUTPUT=DP-1

# Optional: PipeWire sinks to follow the display. Leave empty to leave audio
# alone. The TV's sink only exists while the TV is awake and driving a mode.
DESK_SINK=
TV_SINK=

# Optional: names used in notifications.
DESK_LABEL="Desk monitor"
TV_LABEL="TV"

# Optional: how long to wait for the TV to report itself awake after being
# asked to turn on. A cold LG OLED takes around ten seconds; Quick Start+
# shortens that considerably.
TV_WAIT_SECONDS=30

# Optional: how long to wait for a display to negotiate a mode and appear in
# Hyprland before treating the switch as failed and rolling it back.
MONITOR_WAIT_SECONDS=12

# Optional: wrap Steam Big Picture in gamescope when on the TV (HDR-friendly).
# Set to 0 to go back to classic Big Picture. If gamescope goes badly, also put
# the TV back to SDR in ~/.config/hypr/monitors.lua (cm = "srgb", drop bitdepth
# / sdr_* / max_luminance on DP-1) and run: hyprctl reload
CONSOLE_GAMESCOPE=1

# Optional: use gamescope for Big Picture on the desk too (default: TV only).
# CONSOLE_GAMESCOPE_EVERYWHERE=0

# Optional: gamescope nest size / SDR white level inside HDR.
# GAMESCOPE_WIDTH=3840
# GAMESCOPE_HEIGHT=2160
# GAMESCOPE_REFRESH=120
# GAMESCOPE_REFRESH_DESK=240
# GAMESCOPE_SDR_NITS=203
